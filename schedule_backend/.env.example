# OpenAI API key used only by the backend schedule extractor.
OPENAI_API_KEY=sk-your-openai-key

# Must exactly match INTERNAL_API_KEY in schedule_frontend/.env.local.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Google Cloud Vision service-account file. Keep this file outside git.
GOOGLE_VISION_CREDS_FILE=api_json.json

# Optional upload safety limits.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
