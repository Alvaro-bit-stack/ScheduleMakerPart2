# OpenAI API key (used by schedule_extractor.py to read the schedule image)
OPENAI_API_KEY=sk-your-openai-key

# Optional: path to the Google OAuth client secret JSON (client_id + client_secret),
# used to refresh the user's access token. Defaults to "creds.json".
GOOGLE_CREDS_FILE=creds.json

# Optional: path to the Google Cloud Vision service-account JSON (for OCR).
# ocr.py sets GOOGLE_APPLICATION_CREDENTIALS to "api_json.json" by default.
