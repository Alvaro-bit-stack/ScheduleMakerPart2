# Google OAuth web client
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public origin of this Next.js app. Production must use HTTPS.
# Add "<APP_URL>/api/google/callback" as an authorized Google OAuth redirect URI.
APP_URL=http://localhost:3000

# Server-only FastAPI origin. Production must use HTTPS.
BACKEND_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Generate another random value and set the exact same value in the backend.
INTERNAL_API_KEY=replace-with-a-different-long-random-secret
