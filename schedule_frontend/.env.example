# Google OAuth (from Google Cloud Console -> Credentials -> OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base URL of this Next.js app (used to build the OAuth redirect URI).
# Add "<NEXT_PUBLIC_URL>/api/google/callback" as an authorized redirect URI in Google Cloud.
NEXT_PUBLIC_URL=http://localhost:3000

# Where the FastAPI backend is running.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
